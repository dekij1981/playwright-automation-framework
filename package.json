{
  "name": "playwright-typescript-automation-framework",
  "version": "1.0.0",
  "description": "Portfolio test automation framework built with Playwright and TypeScript.",
  "main": "index.js",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.13.2",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "qa",
    "e2e"
  ],
  "author": "Dejan Jovanovic",
  "license": "MIT"
}
